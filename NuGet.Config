<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Optional local feed for the checks/ dev loop (scripts.publish_local output). The mapping
         below means a missing folder only matters when restoring XBrutal.ImGuiStandalone itself. -->
    <add key="local-xbrutal" value="%HOME%/nuget-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-xbrutal">
      <package pattern="XBrutal.ImGuiStandalone" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
