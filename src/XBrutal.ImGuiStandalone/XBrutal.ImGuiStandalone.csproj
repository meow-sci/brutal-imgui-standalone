<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>XBrutal.ImGuiStandalone</PackageId>
    <!-- Development default only. CI/release pass -p:Version (release: from the vX.Y.Z git tag). -->
    <Version>0.0.0-dev</Version>
    <Description>Standalone main-thread BRUTAL ImGui host with owned native implementations. BRUTAL managed bindings are supplied externally by the consumer.</Description>
    <Authors>meow sci; Alex Sherwin</Authors>
    <Copyright>Copyright (c) 2026 meow sci</Copyright>
    <PackageProjectUrl>https://github.com/meow-sci/brutal-imgui-standalone</PackageProjectUrl>
    <RepositoryUrl>https://github.com/meow-sci/brutal-imgui-standalone</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageTags>imgui;dear-imgui;brutal;glfw;opengl;standalone;ksa</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="XBrutal.ImGuiStandalone.Checks" />
    <!-- Keep standard native assets; exclude the dependency's host-x64 build copy recipe. -->
    <PackageReference Include="Ultz.Native.GLFW" Version="[3.4.0]" ExcludeAssets="build" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="11.0.0-rc.1.26425.128" />
    <Reference Include="Brutal.ImGui"><HintPath>$(BrutalAssembliesDirectory)Brutal.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Glfw"><HintPath>$(BrutalAssembliesDirectory)Brutal.Glfw.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core.Common"><HintPath>$(BrutalAssembliesDirectory)Brutal.Core.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core.Strings"><HintPath>$(BrutalAssembliesDirectory)Brutal.Core.Strings.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Core.Numerics"><HintPath>$(BrutalAssembliesDirectory)Brutal.Core.Numerics.dll</HintPath><Private>false</Private></Reference>
    <None Include="../../runtimes/win-x64/native/*" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="../../runtimes/linux-x64/native/*" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="../../runtimes/osx-arm64/native/*" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <None Include="../../fonts/JetBrainsMono-Regular.ttf" Pack="true" PackagePath="contentFiles/any/net10.0/fonts/" BuildAction="None" PackageCopyToOutput="true" PackageFlatten="false" />
    <None Include="../../fonts/JetBrainsMono-Regular-license.txt" Pack="true" PackagePath="licenses/" />
    <None Include="../../licenses/*" Pack="true" PackagePath="licenses/" />
    <None Include="../../LICENSE;../../README.md;../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/COMPATIBILITY.md;../../native/manifest.json;../../native/accessor-contract.json" Pack="true" PackagePath="docs/" />
    <None Include="../../buildTransitive/XBrutal.ImGuiStandalone.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
